HELLO V1 GAME "Guardians" PROTO 1
VIEW LOGICAL_W 1024 LOGICAL_H 576 TILE_W 32 TILE_H 32

CLS
BG 249 207 177 255

# FONT_LOAD 1 "assets/AtkinsonHyperlegible-Regular.ttf" 64
# FONT_LOAD 2 "assets/AtkinsonHyperlegible-Bold.ttf"    64
FONT_LOAD 1 "../assets/AtkinsonHyperlegible-Regular.ttf" 64
FONT_LOAD 2 "../assets/AtkinsonHyperlegible-Bold.ttf"    64

FONT_USE  2

FONT_COLOR 66 130 150 255         
FONT_SIZE 72
TEXT_ALIGN CENTER
TEXT 512 30 "Guardians" 

FONT_COLOR 0 0 0 255       # black
FONT_SIZE 36
TEXT_ALIGN CENTER

HITBOX start 460 140 100 50
TARGET start  "logs/start.cmdlog"
TEXT 512 150 "Start"

# HITBOX start2 712 320 100 199
# TARGET start2  "logs/start2.cmdlog"
# TEXT 712 330 "Start2"

HITBOX rules  460 200 100 50
TARGET rules  "logs/rules.cmdlog"
TEXT 512 205 "Rules"

HITBOX description  410 255 200 40
TARGET description  "logs/description.cmdlog"
TEXT 512 255 "Description"


FONT_COLOR 0 0 0 255
FONT_SIZE 30

HITBOX easy 112 320 200 40
TARGET easy "logs/galleryeasy.cmdlog"
TEXT 212 320 "Gallery Easy"

HITBOX medium 412 320 200 40
TARGET medium "logs/gallerymedium.cmdlog"
TEXT 512 320 "Gallery Medium"

HITBOX hard 712 320 200 40
TARGET hard "logs/galleryhard.cmdlog"
TEXT 812 320 "Gallery Hard"


IMAGE_LOAD_SHEET 1 "../assets/g_e_ss.png" 5 6
ANIM_SET_TOTAL    1 26                      
ANIM_SET_FPS      1 2
ANIM_DRAW         1 0 0 0.4

IMAGE_LOAD_SHEET 2 "../assets/b_e_ss.png" 5 6
ANIM_SET_TOTAL    2 26
ANIM_SET_FPS      2 2
# top-right: x = 1024 - (frameW * scale) - margin

ANIM_DRAW         2 864 0 0.4

IMAGE_LOAD_SHEET 3 "../assets/octopus_left.png" 5 6
ANIM_SET_TOTAL    3 26                      
ANIM_SET_FPS      3 4
ANIM_DRAW         3 0 410 0.4

IMAGE_LOAD_SHEET 4 "../assets/octopus_right.png" 5 6
ANIM_SET_TOTAL    4 26                      
ANIM_SET_FPS      4 4
ANIM_DRAW         4 864 410 0.4

FLIP 1
