HELLO V1 GAME "Mob Gallery" PROTO 1
VIEW LOGICAL_W 1024 LOGICAL_H 576 TILE_W 32 TILE_H 32

CLS
BG 176 163 170 255


# FONT_LOAD 1 "../assets/AtkinsonHyperlegible-Regular.ttf" 64
FONT_LOAD 2 "../assets/AtkinsonHyperlegible-Bold.ttf"    64
FONT_USE  2

FONT_COLOR 66 130 170 255         
FONT_SIZE 72
TEXT_ALIGN CENTER
TEXT 512 50 "Hard LvL Mob Gallery"


HITBOX devil 50 170 100 100
TARGET devil "logs/assets/devil.cmdlog"
FONT_COLOR 220 10 10 255
FONT_SIZE 34
TEXT 100 130 "Devil"
IMAGE_LOAD_SHEET 1 "../assets/enemies/hard/codexgigas_devil.png" 3 3
ANIM_SET_TOTAL 1 8
ANIM_SET_FPS 1 2
ANIM_DRAW 1 50 170 1.5


HITBOX souls 250 170 100 100
TARGET souls "logs/assets/souls.cmdlog"
FONT_COLOR 220 0 220 255
FONT_SIZE 34
TEXT 300 130 "Souls"
IMAGE_LOAD_SHEET 2 "../assets/enemies/hard/souls.png" 2 3
ANIM_SET_TOTAL 2 6
ANIM_SET_FPS 2 1
ANIM_DRAW 2 250 170 0.085


HITBOX vamp 450 170 100 100
TARGET vamp "logs/assets/vamp.cmdlog"
FONT_COLOR 255 15 0 255
FONT_SIZE 34
TEXT 500 130 "Vamp"
IMAGE_LOAD_SHEET 3 "../assets/enemies/hard/vamp.png" 5 5
ANIM_SET_TOTAL 3 25
ANIM_SET_FPS 3 2
ANIM_DRAW 3 450 170 1.55

FONT_USE 1
FONT_COLOR 0 0 255 255
FONT_SIZE 30
TEXT 890 545 "Press B to return"
FLIP 1